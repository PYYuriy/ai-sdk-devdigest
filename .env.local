# ---------------------------------------------------------------------------
# DevDigest environment variables (copy to `.env` and fill in).
#
# NOTE: `.gitignore` ignores `.env*`. This example file is intended to be
# committed as documentation — add it explicitly with `git add -f .env.example`.
# ---------------------------------------------------------------------------

# --- Langfuse (LLM observability) ------------------------------------------
# Project keys from Langfuse > Settings > API Keys.
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_BASE_URL="http://localhost:3001"


# Langfuse ingestion endpoint.
#   - Self-hosted (see docker-compose.langfuse.yml): http://localhost:3001
#   - Langfuse Cloud EU: https://cloud.langfuse.com
#   - Langfuse Cloud US: https://us.cloud.langfuse.com
AI_GATEWAY_API_KEY=xxxxxxxxx
DATABASE_PATH="./sqlite_data/sqlite.db"
# Optional: logical environment label shown in Langfuse (e.g. development,
# staging, production). Must be lowercase alphanumeric (hyphens/underscores ok).
# LANGFUSE_TRACING_ENVIRONMENT="development"

# Optional: set to 1 to emit the extra spans Next.js instruments internally.
# NEXT_OTEL_VERBOSE=1

# --- Ollama (local models) -------------------------------------------------
# The app talks to the native Ollama API. Override only if Ollama runs
# elsewhere. Defaults to http://localhost:11434/api in app/ollama.ts.
# OLLAMA_BASE_URL="http://localhost:11434/api"
